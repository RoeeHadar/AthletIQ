{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/memory-session-start.mjs",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "node .cursor/hooks/memory-precompact.mjs",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/memory-stop.mjs",
        "timeout": 15,
        "loop_limit": 2
      }
    ],
    "preToolUse": [
      {
        "command": "[ ! -f \".cursor/skills/impeccable/scripts/hook-before-edit.mjs\" ] || node \".cursor/skills/impeccable/scripts/hook-before-edit.mjs\"",
        "timeout": 5
      }
    ]
  }
}
