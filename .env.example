# AthletIQ local environment — copy to `.env` and fill in. Never commit `.env`.
# Implements: SEC-001, SEC-002

# PostgreSQL (Compose local defaults — change password for anything non-demo)
POSTGRES_USER=athletiq
POSTGRES_PASSWORD=athletiq
POSTGRES_DB=athletiq
DATABASE_URL=postgresql://athletiq:athletiq@localhost:5432/athletiq

# Unused API-Sports fallback only. Live ingest is --provider nba-stats (no key).
API_SPORTS_KEY=

# Reproducibility / paths (NFR-001 knobs; Compose overrides paths inside containers)
ATHLETIQ_SEED=42
ATHLETIQ_RAW_PATH=data/raw
ATHLETIQ_ARTIFACTS_PATH=artifacts
ATHLETIQ_LOG_LEVEL=INFO
